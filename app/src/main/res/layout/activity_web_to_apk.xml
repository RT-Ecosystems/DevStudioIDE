<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Website to APK"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Website URL"
            android:textColor="#757575"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="https://example.com"
            android:inputType="textUri"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="App Name"
            android:textColor="#757575"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etAppName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="My App"
            android:inputType="textCapWords"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Package Name"
            android:textColor="#757575"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etPackageName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="com.example.myapp"
            android:inputType="textNoSuggestions"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/ivIconPreview"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="#F0F0F0"
                android:src="@android:drawable/ic_menu_gallery"
                android:scaleType="centerCrop"
                android:layout_marginEnd="16dp" />

            <Button
                android:id="@+id/btnChooseIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Choose Icon" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Theme Color"
            android:textColor="#757575"
            android:textSize="13sp" />

        <Spinner
            android:id="@+id/spinnerColor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnBuildWebApp"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Build Web App"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1565C0" />
    </LinearLayout>
</ScrollView>
